    "Watermark PDF": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علامة مائية على PDF"
          }
        }
      }
    },
    "Works offline · Your files never leave your iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل دون إنترنت · ملفاتك لا تغادر جهازك"
