      }
    },
    "Turn pages the right way": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّل اتجاه الصفحات"
          }
        }
      }
    },
    "Turn photos into one PDF": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل الصور إلى ملف PDF واحد"
          }
        }
      }
    },
    "Turns every page into a picture. Much smaller for scans, but text can no longer be selected or searched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل كل صفحة إلى صورة. أصغر بكثير للمستندات الممسوحة، لكن لا يمكن تحديد النص أو البحث فيه بعد ذلك."
          }
        }
      }
    },
    "Type the watermark text first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب نص العلامة المائية أولاً."
