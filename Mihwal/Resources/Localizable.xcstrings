{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Add numbers to every page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أرقاماً إلى الصفحات"
          }
        }
      }
    },
    "Add to Favorites": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إلى المفضلة"
          }
        }
      }
    },
