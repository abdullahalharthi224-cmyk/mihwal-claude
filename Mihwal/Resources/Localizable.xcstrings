    "A PDF needs at least one page. Leave at least one page unselected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف PDF يحتاج صفحة واحدة على الأقل. اترك صفحة واحدة على الأقل دون تحديد."
          }
        }
      }
    },
    "A watermark is a visual mark, not a security feature: PDF editors can remove it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العلامة المائية علامة مرئية وليست حماية: برامج تحرير PDF تستطيع إزالتها."
          }
        }
      }
    },
