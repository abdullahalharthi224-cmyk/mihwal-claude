      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستصل هذه الأداة في تحديث قادم."
          }
        }
      }
    },
    "Turn or mirror your photos": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوّر صورك أو اقلبها"
          }
        }
      }
    },
    "Turn pages into separate files": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل الصفحات إلى ملفات منفصلة"
          }
        }
      }
    },
    "Turn pages the right way": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّل اتجاه الصفحات"
          }
        }
      }
    },
    "Turn photos into one PDF": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل الصور إلى ملف PDF واحد"
          }
